# PoH 参加スクリプト 環境変数テンプレート
# このファイルを .env にコピーして値を設定すること
# cp .env.example .env

# ウォレットの秘密鍵（0xなしでも可）
PRIVATE_KEY=あなたのウォレット秘密鍵をここに

# Base Sepolia RPC（変更不要）
RPC_URL=https://sepolia.base.org

# コントラクトアドレス (Base Mainnet)
OPEPE_ADDRESS=0x06AC76da01657e40a6724E2035dDAdC6f57eD034
TICKET_ADDRESS=0xF4b7f91d25Ab667E6535736C168f9B2Ccc944D76
WINNERNFT_ADDRESS=0xCeccC6487723685BA9279c9f68C406d7816009Ae
POHGAME_ADDRESS=0x0B69F81aa064BdE21F0e0A8FEeAf206bB36481Bd

# GitHub（お題・結果取得用。変更不要）
GITHUB_REPO=openclaw29831/poh-topics
GITHUB_BRANCH=master
