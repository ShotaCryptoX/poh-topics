# PoH Participation Scripts - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ----------------------------------------------------------------
# REQUIRED
# ----------------------------------------------------------------

# Your wallet's private key (with 0x prefix)
# WARNING: Never share this value or commit .env to any repository
PRIVATE_KEY=0xyour_private_key_here

# Your wallet address (with 0x prefix)
# Note: Used for reference only. Address is derived from PRIVATE_KEY at runtime.
WALLET_ADDRESS=0xyour_wallet_address_here

# ----------------------------------------------------------------
# OPTIONAL (defaults are pre-filled)
# ----------------------------------------------------------------

# Base Mainnet RPC URL
RPC_URL=https://base-rpc.publicnode.com

# Contract addresses (do not change unless contracts are redeployed)
OPEPE_ADDRESS=0x06AC76da01657e40a6724E2035dDAdC6f57eD034
TICKET_ADDRESS=0xF4b7f91d25Ab667E6535736C168f9B2Ccc944D76
POHGAME_ADDRESS=0x0B69F81aa064BdE21F0e0A8FEeAf206bB36481Bd
